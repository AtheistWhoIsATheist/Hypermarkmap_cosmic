# Nihiltheism Architect — Environment Configuration Example
# Copy this file to .env.local (or .env) and fill in only what you need.
# Notice: Never commit API secret keys or credentials to version control.
# Every variable below is optional; the server boots without any of them.

# Optional Firebase / Google Identity Configuration (Client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side write authentication (optional).
# When set, API mutations require: Authorization: Bearer <key>
# When unset, the write surface is guarded by the same-origin policy alone and one
# startup warning is logged.
WRITE_API_KEY=
ADMIN_API_KEY=

# Server-side AI generation (optional).
# Without a key, generation returns deterministic labelled proposals.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Data layer (optional).
# DATA_DIR selects the SQLite directory; default: data/
DATA_DIR=
