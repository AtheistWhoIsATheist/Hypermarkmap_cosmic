{
  "name": "nihiltheism-architect",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "clear-cache": "rm -rf node_modules/.vite",
    "dev": "bun run clear-cache && NODE_ENV=development PORT=58306 bun run --hot server.ts",
    "build": "bun run clear-cache && tsc && vite build",
    "build:server": "bun build --target=node --format=cjs --external vite --outfile dist/server.cjs server.ts",
    "prod": "bun run build && NODE_ENV=production PORT=56831 bun run server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "bun run vite preview",
    "test": "bun tests/runner.ts",
    "test:regression": "bun test tests/regression.test.ts",
    "test:client:spatial": "bun tests/spatial.test.ts",
    "test:client:export": "bun tests/export.test.ts",
    "test:client:workspace": "bun tests/workspace.test.ts",
    "test:client:ingestion": "bun tests/ingestion.test.ts",
    "test:runtime": "bun tests/runtime.zosite.ts",
    "test:runtime:bundle": "bun run build:server && bun tests/runtime.ts",
    "test:all": "bun run test && bun run test:regression && bun run test:client:spatial && bun run test:client:export && bun run test:client:workspace && bun run test:client:ingestion && bun run test:runtime && bun run test:runtime:bundle"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
